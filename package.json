{
  "name": "fork-in",
  "version": "0.2.0",
  "description": "omp and pi plugin: /fork-in-herdr and /fork-in-tmux fork the current agent session into a new herdr tab or tmux window",
  "omp": {
    "extensions": ["./src/omp.ts"]
  },
  "pi": {
    "extensions": ["./src/pi.ts"]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.0"
  }
}
